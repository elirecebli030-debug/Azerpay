# PHP xətalarını gizlət
php_flag display_errors off
php_flag display_startup_errors off
php_value error_reporting 0

# İndeksləməni söndür
Options -Indexes

# BÜTÜN FAYLLARA GİRİŞİ BLOKLA
Order Deny,Allow
Deny from all

# YALNIZ telegram-handler.php faylına POST icazəsi
<Files "telegram-handler.php">
    <Limit POST>
        Order Allow,Deny
        Allow from all
    </Limit>
</Files>

# Konfiq fayllarını blokla
<FilesMatch "\.(htaccess|htpasswd|ini|log|txt|json|xml|config)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>
